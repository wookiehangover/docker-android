{
  "name": "serve-droid",
  "version": "0.5.1",
  "description": "Host an Android emulator, use it from any browser, and control it with WebMCP",
  "keywords": [
    "android",
    "emulator",
    "webmcp",
    "mcp",
    "ai-agents",
    "remote",
    "docker"
  ],
  "homepage": "https://github.com/wookiehangover/serve-droid#readme",
  "bugs": "https://github.com/wookiehangover/serve-droid/issues",
  "type": "module",
  "bin": {
    "serve-droid": "./bin/serve-droid.js"
  },
  "exports": {
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./middleware": {
      "types": "./lib/middleware.d.ts",
      "default": "./lib/middleware.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "hub",
    "web-ui/*.py",
    "web-ui/*.html",
    "web-ui/tools.json",
    "web-ui/requirements.txt",
    "web-ui/native-requirements.txt",
    "web-ui/pyproject.toml",
    "web-ui/uv.lock",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "release": "node scripts/release.mjs",
    "test:e2e": "bash test/lifecycle.sh",
    "test:webmcp": "node test/webmcp.mjs",
    "test:agent": "node test/agent.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wookiehangover/serve-droid.git",
    "directory": "packages/serve-droid"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "devDependencies": {
    "playwright": "1.65.1"
  }
}
